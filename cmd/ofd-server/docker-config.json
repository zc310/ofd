  "notify_workers": 4,
  "job_timeout": "300s",
  "max_job_attempts": 3,
  "retention": "168h",
  "soffice_path": "",
  "chrome_path": "",
  "chrome_no_sandbox": true,
  "allow_insecure_ftp": false,
  "allow_insecure_s3": false,
  "ftp_targets": {},
  "s3_targets": {},
