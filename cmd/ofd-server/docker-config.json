{
  "listen": ":9705",
  "api_key": "",
  "db_path": "/var/lib/ofd-server/jobs.db",
  "temp_dir": "/var/tmp/ofd-server",
  "output_dir": "/var/lib/ofd-server/out",
  "max_upload_bytes": 268435456,
  "max_stream_bytes": 67108864,
  "url_timeout": "30s",
