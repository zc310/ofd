{
  "name": "OFD WASM 阅读器",
  "short_name": "OFD 阅读器",
  "description": "在浏览器中查看 OFD 文档",
  "lang": "zh-CN",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#cfd5de",
  "theme_color": "#172033",
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/ofd": [".ofd"]
      }
    }
  ],
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
